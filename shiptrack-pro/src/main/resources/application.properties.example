# Load local secrets from shiptrack-pro/.env.
# The .env file must be in the same folder as pom.xml and must be Git-ignored.
spring.config.import=optional:file:.env[.properties]

spring.application.name=shiptrack-pro

# Database
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/shiptrack_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Server
server.port=8081
#server.servlet.context-path=/api


# JWT
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}

# Demo data
app.seed.demo-data=true

# Twilio SMS
twilio.account-sid=${TWILIO_ACCOUNT_SID:}
twilio.auth-token=${TWILIO_AUTH_TOKEN:}
twilio.from-number=${TWILIO_FROM_NUMBER:}

# Gmail SMTP
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_APP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

## Google OAuth2
#spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
#spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
#spring.security.oauth2.client.registration.google.scope=openid,profile,email
#spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}

firebase.service-account-path=${FIREBASE_SERVICE_ACCOUNT_PATH}

cloudinary.url=${CLOUDINARY_URL}


# Google Maps (Milestone 2 integration)
google.maps.api-key=${GOOGLE_MAPS_API_KEY:}
# Leave the URLs as-is unless you proxy the Google APIs. When the key is blank the
# app still works: distances fall back to a straight-line estimate.
google.maps.geocode-url=https://maps.googleapis.com/maps/api/geocode/json
google.maps.directions-url=https://maps.googleapis.com/maps/api/directions/json
google.maps.timeout-ms=5000

# ETA and delay risk (Milestone 4)
# The forecast is recalculated on every tracking event; this sweep also catches
# shipments that have gone quiet, where risk grows with time alone.
eta.refresh.enabled=true
eta.refresh.interval-ms=900000
eta.refresh.initial-delay-ms=60000

# ---- Milestone 5: alert delivery ----
# Everything below is optional. With the mail and Twilio values blank the app
# still runs and records in-app notifications; only email and SMS are skipped.
notifications.email.enabled=true
notifications.email.from=${MAIL_USERNAME:}
notifications.sms.enabled=true
notifications.sms.timeout-ms=5000
# how long the same alert for the same shipment is suppressed for one recipient
notifications.cooldown-minutes=30
