# Copy to shiptrack-pro/.env and fill in your own local values.
# .env is Git-ignored — never commit real credentials.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/shiptrack_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT (use a long random value)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Google Maps (Geocoding + Directions/Distance Matrix)
GOOGLE_MAPS_API_KEY=

# Cloudinary (proof-of-delivery uploads)
CLOUDINARY_URL=

# Gmail SMTP notifications
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase push notifications (local path to the service-account JSON)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
